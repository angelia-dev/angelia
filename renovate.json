{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "UTC",
  "minimumReleaseAge": "14 days",
  "packageRules": [
    {
      "description": "Group Go module updates into one weekly pull request",
      "matchManagers": ["gomod"],
      "groupName": "Go modules",
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "Group the admin UI's React and TanStack packages (web/)",
      "matchManagers": ["npm"],
      "matchFileNames": ["web/package.json"],
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom", "/^@tanstack\\//"],
      "groupName": "web: React and TanStack",
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "Group the remaining admin UI (web/) npm updates, weekly",
      "matchManagers": ["npm"],
      "matchFileNames": ["web/package.json"],
      "groupName": "web: npm packages",
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "Pin GitHub Action references by full commit SHA and keep the SHAs updated",
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "groupName": "GitHub Actions",
      "schedule": ["before 6am on monday"]
    }
  ]
}
